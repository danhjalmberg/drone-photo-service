<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Drone Photo Service Checkstyle configuration.

    This configuration checks objective formatting and common readability
    problems. It deliberately does not require:
      - final on every parameter
      - Javadocs on private fields
      - renamed constructor parameters to avoid field shadowing
      - constants for every numeric literal
-->
<module name="Checker">

    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- Repository-wide file formatting. -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <module name="NewlineAtEndOfFile"/>

    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern"
                  value="^(package|import) .*|^ *\* .*https?://.*$"/>
    </module>

    <!-- Optional project-specific exceptions. -->
    <module name="SuppressionFilter">
        <property name="file" value="${checkstyle.suppressions.file}"/>
        <property name="optional" value="true"/>
    </module>

    <module name="TreeWalker">

        <module name="RegexpSinglelineJava">
            <property name="format" value="\s+$"/>
            <property name="minimum" value="0"/>
            <property name="maximum" value="0"/>
            <property name="message" value="Line contains trailing whitespace."/>
        </module>

        <!-- Imports and source organization. -->
        <module name="UnusedImports"/>
        <module name="AvoidStarImport"/>
        <module name="ModifierOrder"/>
        <module name="RedundantModifier"/>
        <module name="OneStatementPerLine"/>
        <module name="FinalClass"/>
        <module name="VisibilityModifier"/>

        <!-- Documentation of methods in the configured visibility scope. -->
        <module name="JavadocMethod"/>

        <!-- Whitespace and braces. -->
        <module name="WhitespaceAfter"/>
        <module name="WhitespaceAround"/>
        <module name="NoWhitespaceBefore"/>
        <module name="ParenPad"/>
        <module name="NeedBraces"/>
        <module name="LeftCurly"/>
        <module name="RightCurly"/>

        <!-- Common readability and correctness risks. -->
        <module name="EmptyStatement"/>
        <module name="EqualsHashCode"/>
        <module name="FallThrough"/>
        <module name="InnerAssignment"/>
        <module name="MissingSwitchDefault"/>
    </module>
</module>
